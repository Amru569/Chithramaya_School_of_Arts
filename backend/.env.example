# Copy this to .env for local development (optional — every setting has
# a working default for localhost). On Render, set these as real
# environment variables in the dashboard instead of a .env file.

# Comma-separated list of allowed frontend origins (no spaces).
# Local dev default already covers the Vite dev server — override only
# for production:
# FRONTEND_ORIGINS=https://your-chithramaya.vercel.app

# Required in production so the session cookie works cross-site between
# Vercel (frontend) and Render (backend). Leave unset/false for local dev.
# SESSION_COOKIE_SECURE=true

# Change these before going live — the defaults are meant for local testing only.
# DEFAULT_ADMIN_PASSWORD=change-me
# DEFAULT_ASSISTANT_PASSWORD=change-me

# Only needed if you move off the default SQLite file (e.g. to a managed
# Postgres instance for production scale):
# DATABASE_URL=postgresql://user:password@host:5432/dbname
